  const DATA_URL = 'https://raw.githubusercontent.com/Cube-oo/F9UTrackside/refs/heads/main/classifica.json?ts=' + Date.now();
  const root = document.getElementById('f9u-dashboard');
  const search = document.getElementById('f9u-search');
  const dialog = document.getElementById('f9u-race-dialog');
  let data, standings = [];
  const esc = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const position = value => Number.isInteger(value) && value > 0 ? value : null;
  function points(pos) {
    const table = [0,100,80,70,60,50,45,40,36,32,29,26,24,22,20,18,16];
    return position(pos) ? (table[pos] ?? Math.max(0, 32-pos)) : 0;
  }
  function time(ms) {
    return `${Math.floor(ms/60000)}:${String(Math.floor(ms/1000)%60).padStart(2,'0')},${String(ms%1000).padStart(3,'0')}`;
  }
  function score(p) {
    const valid = p.results.filter(r=>position(r.finishPosition)).map(r=>({...r,points:points(r.finishPosition)}));
    // Mantiene la regola del widget originale: il bonus conta i risultati con punti > 0.
    const scored = valid.filter(r=>r.points>0).sort((a,b)=>b.points-a.points || a.raceId.localeCompare(b.raceId));
    const counted = scored.slice(0,3).map(r=>r.raceId);
    const base = scored.slice(0,3).reduce((sum,r)=>sum+r.points,0);
    const multiplier = scored.length>=5?1.15:scored.length===4?1.10:scored.length===3?1.05:1;
    return {...p,base,multiplier,total:Math.round(base*multiplier),fourth:scored[3]?.points||0,counted,completed:valid.length};
  }
  const sameRank=(a,b)=>a.total===b.total && a.fourth===b.fourth && a.base===b.base;
  function rank(pilots) {
    const list=pilots.map(score).sort((a,b)=>b.total-a.total || b.fourth-a.fourth || b.base-a.base || a.name.localeCompare(b.name,'it',{sensitivity:'base'}));
    list.forEach((p,i)=>{p.rank=i&&sameRank(p,list[i-1])?list[i-1].rank:i+1;p.gap=(list[0]?.total||0)-p.total;});
    return list;
  }
  function validate(d) {
    if(d?.schemaVersion!==2 || !Array.isArray(d.pilots) || !Array.isArray(d.races) || d.races.length!==5) throw Error('classifica.json deve usare il formato versione 2.');
    const ids=new Set(), races=new Set(d.races.map(r=>r.id));
    if(races.size!==5)throw Error('Identificativi gara duplicati.');
    for(const p of d.pilots){
      if(!p.id||ids.has(p.id)||!['pro','open'].includes(p.category)||!Array.isArray(p.results)||p.results.length!==5)throw Error('Dati pilota non validi o identificativo duplicato.');
      ids.add(p.id);
      const seen=new Set();
      for(const r of p.results){
        if(!races.has(r.raceId)||seen.has(r.raceId)||(r.finishPosition!==null&&!position(r.finishPosition)))throw Error('Risultato di gara non valido per '+p.name);
        seen.add(r.raceId);
        if(r.qualification?.status==='timed' && (!Number.isInteger(r.qualification.timeMs)||r.qualification.timeMs<=0))throw Error('Tempo di qualifica non valido per '+p.name);
      }
    }
    return d;
  }
  function latest(p) {
    const results=data.races.map(r=>p.results.find(x=>x.raceId===r.id)).filter(r=>position(r.finishPosition)).slice(-3);
    if(!results.length)return '';
    const last=results.at(-1).finishPosition, previous=results.at(-2)?.finishPosition;
    const direction=previous===undefined?'':last<previous?' ↗':last>previous?' ↘':' →';
    return `<div class="f9u-recent" title="Piazzamenti di categoria nelle ultime gare con risultato disponibile">Ultimi risultati: ${results.map(r=>`<span title="${esc(r.raceId.toUpperCase())}">${r.finishPosition}°</span>`).join(' → ')}${direction}</div>`;
  }
  function qualifyingRanks(d) {
    for(const race of d.races)for(const category of ['pro','open']){
      const entries=d.pilots.filter(p=>p.category===category).map(p=>p.results.find(r=>r.raceId===race.id)).concat((d.unresolvedQualifications||[]).filter(r=>r.raceId===race.id&&r.category===category)).filter(r=>r?.qualification?.status==='timed').sort((a,b)=>a.qualification.timeMs-b.qualification.timeMs);
      entries.forEach((r,i)=>{r.qualification.categoryPosition=i&&r.qualification.timeMs===entries[i-1].qualification.timeMs?entries[i-1].qualification.categoryPosition:i+1;});
    }
  }
  function raceCell(p,race) {
    const r=p.results.find(r=>r.raceId===race.id), hasResult=position(r?.finishPosition);
    if(!hasResult && !r?.qualification && !r?.registered)return '<td>—</td>';
    const label=hasResult?`${r.finishPosition}°`:r.qualification?.status==='timed'?'Q':'Info';
    const discarded=hasResult&&!p.counted.includes(race.id);
    return `<td><button type="button" class="f9u-race-button${discarded?' f9u-discarded':''}" data-pilot="${esc(p.id)}" data-race="${esc(race.id)}" aria-label="${esc(p.name)}, ${esc(race.label)}: apri dettaglio" title="Apri qualifica e risultato${discarded?' · Risultato scartato':''}">${label}</button></td>`;
  }
  function renderStandings() {
    const query=search.value.trim().toLocaleLowerCase('it');
    for(const category of ['pro','open']){
      const list=standings.filter(p=>p.category===category && `${p.name} ${p.team} ${(p.aliases||[]).join(' ')}`.toLocaleLowerCase('it').includes(query));
      document.getElementById('f9u-empty-'+category).style.display=list.length?'none':'block';
      document.getElementById('f9u-score-body-'+category).innerHTML=list.map(p=>`<tr>
        <td>${p.total>0?p.rank:'—'}</td>
        <td><div class="pilot-name">${esc(p.name)}</div><div class="pilot-team">${esc(p.team)}</div>${latest(p)}<div class="f9u-pilot-meta">${p.completed} gare con risultato${p.total?` · ${p.gap?`${p.gap} pt dalla vetta`:'In testa a punti'}`:''}</div></td>
        ${data.races.map(r=>raceCell(p,r)).join('')}
        <td class="f9u-right">${p.base}</td><td class="f9u-right">x${p.multiplier.toFixed(2)}</td><td class="f9u-right"><strong>${p.total}</strong></td></tr>`).join('');
    }
  }
  const statuses={absent:'Assente',dnq:'DNQ',unavailable:'N/A',not_available:'—'};
  function renderRaceTables() {
    for(let i=1;i<=4;i++){
      const raceId='r'+i, tbody=document.getElementById('f9u-gara'+i).querySelector('tbody');
      const rows=data.pilots.map(p=>({p,r:p.results.find(r=>r.raceId===raceId)})).filter(x=>x.r?.registered).concat((data.unresolvedQualifications||[]).filter(r=>r.raceId===raceId).map(r=>({p:{name:r.name,category:r.category},r,unresolved:true}))).sort((a,b)=>a.r.displayOrder-b.r.displayOrder);
      tbody.innerHTML=rows.map(({p,r,unresolved})=>{
        const q=r.qualification, timed=q?.status==='timed';
        const badge=(r.categoryLabel||p.category).startsWith('OPEN - E')?'opene':p.category;
        return `<tr><td class="col-pos">${esc(timed?q.overallPosition||'—':i===2||i===4?r.displayOrder:'—')}</td><td><div class="pilot-name">${esc(p.name)}</div><div class="pilot-call">${esc(r.callsign||p.team)}${unresolved?' · Abbinamento da verificare':''}</div></td><td class="col-cat"><span class="badge badge-${badge}">${esc(r.categoryLabel||p.category.toUpperCase())}</span></td><td class="col-time ${timed?'f9u-time-value':'f9u-time-status'}">${timed?time(q.timeMs):statuses[q?.status]||'—'}</td></tr>`;
      }).join('');
    }
  }
  function detail(p,raceId) {
    const r=p.results.find(r=>r.raceId===raceId), race=data.races.find(r=>r.id===raceId), q=r.qualification;
    const qpos=position(q?.categoryPosition), finish=position(r.finishPosition);
    const qualification=q?.status==='timed'?`${time(q.timeMs)}${qpos?` · ${qpos}° ${p.category.toUpperCase()}`:''}`:q?.status==='not_available'||!q?'Non disponibile':statuses[q.status]||'Non disponibile';
    const delta=qpos&&finish?qpos-finish:null;
    const comparison=delta===null?'Confronto non disponibile':delta>0?`+${delta} ${delta===1?'posizione recuperata':'posizioni recuperate'}`:delta<0?`${Math.abs(delta)} ${delta===-1?'posizione persa':'posizioni perse'}`:'Stessa posizione';
    const contribution=finish?(p.counted.includes(raceId)?'Conteggiato nei tre migliori risultati':'Scartato dal punteggio base'):'Nessun risultato di gara disponibile';
    document.getElementById('f9u-dialog-title').textContent=`${p.name} · ${race.label}`;
    document.getElementById('f9u-dialog-content').innerHTML=`<p class="f9u-detail-category">Categoria ${esc(p.category.toUpperCase())}</p><dl class="f9u-detail-grid"><div><dt>Qualifica</dt><dd>${esc(qualification)}</dd></div><div><dt>Risultato gara</dt><dd>${finish?`${finish}° · ${points(finish)} punti`:'Non disponibile'}</dd></div><div><dt>Dalla qualifica alla gara</dt><dd>${esc(comparison)}</dd></div><div><dt>Punteggio campionato</dt><dd>${esc(contribution)}</dd></div></dl><p class="f9u-detail-note">La posizione di qualifica di categoria è ricavata dai tempi disponibili. Il confronto indica la differenza rispetto al risultato finale, non il numero di sorpassi in gara.</p>`;
    dialog.showModal();
  }
  // Initialize
  root.addEventListener('click',e=>{const button=e.target.closest('button[data-pilot]');if(button){const p=standings.find(p=>p.id===button.dataset.pilot);if(p)detail(p,button.dataset.race);}});
  document.getElementById('f9u-close-detail').addEventListener('click',()=>dialog.close());
  search.addEventListener('input',renderStandings);
  async function load(){
    try{
      const response = await fetch(DATA_URL, { cache: 'no-store' });

      if(!response.ok){
        throw Error('Impossibile caricare classifica.json · HTTP ' + response.status);
      }

      const incoming = await response.json();
      data = validate(incoming);

      qualifyingRanks(data);

      standings = ['pro','open'].flatMap(category =>
        rank(data.pilots.filter(p => p.inStandings && p.category === category))
      );

      renderStandings();
      renderRaceTables();
    }catch(error){
      const box = document.getElementById('f9u-error');
      box.textContent = 'Errore dati: ' + error.message;
      box.style.display = 'block';
      console.error('F9U ranking:', error);
    }finally{
      document.getElementById('f9u-loader').style.display = 'none';
    }
  }
  load();
})();

</script>
