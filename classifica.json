<!-- Widget F9U: classifica e gare 1-4 -->
<style>
/* classifica */
#f9u-classifica-widget{
      --f9u-bg:#ffffff;
      --f9u-surface:#ffffff;
      --f9u-surface-soft:#f6f8fb;
      --f9u-border:#e2e7ee;
      --f9u-text:#172033;
      --f9u-muted:#747e8d;
      --f9u-pro:#245fc7;
      --f9u-open:#c62828;

      font-family: Inter, Arial, Helvetica, sans-serif;
      width:100%;
      color:var(--f9u-text);
    }

    #f9u-classifica-widget *{
      box-sizing:border-box;
    }

    #f9u-classifica-widget .f9u-toolbar{
      margin-bottom:24px;
      display:flex;
      justify-content:flex-end;
    }

    #f9u-classifica-widget .f9u-field{
      width:min(100%, 420px);
    }

    #f9u-classifica-widget .f9u-field label{
      display:block;
      margin-bottom:7px;
      font-size:11px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.10em;
      color:var(--f9u-muted);
    }

    #f9u-classifica-widget input[type="search"]{
      width:100%;
      padding:12px 14px;
      border:1px solid var(--f9u-border);
      border-radius:10px;
      box-sizing:border-box;
      font-size:14px;
      color:var(--f9u-text);
      background:#fff;
      outline:none;
      transition:border-color .18s ease, box-shadow .18s ease;
    }

    #f9u-classifica-widget input[type="search"]::placeholder{
      color:#9aa3af;
    }

    #f9u-classifica-widget input[type="search"]:focus{
      border-color:#7ca4e8;
      box-shadow:0 0 0 3px rgba(36,95,199,.10);
    }

    #f9u-classifica-widget .f9u-section{
      margin-bottom:32px;
      border:1px solid var(--f9u-border);
      border-radius:14px;
      overflow:hidden;
      background:var(--f9u-surface);
      box-shadow:0 8px 24px rgba(32,48,72,.07);
    }

    #f9u-classifica-widget .f9u-title{
      margin:0;
      padding:17px 18px 15px 22px;
      font-size:21px;
      font-weight:800;
      line-height:1.2;
      text-transform:uppercase;
      letter-spacing:.02em;
      background:#fafbfd;
      border-bottom:1px solid var(--f9u-border);
      position:relative;
    }

    #f9u-classifica-widget .f9u-title::before{
      content:"";
      position:absolute;
      left:0;
      top:0;
      bottom:0;
      width:5px;
    }

    #f9u-classifica-widget .f9u-title-pro{
      color:var(--f9u-pro);
    }

    #f9u-classifica-widget .f9u-title-pro::before{
      background:var(--f9u-pro);
    }

    #f9u-classifica-widget .f9u-title-open{
      color:var(--f9u-open);
    }

    #f9u-classifica-widget .f9u-title-open::before{
      background:var(--f9u-open);
    }

    #f9u-classifica-widget .f9u-table-wrap{
      overflow-x:auto;
      background:#fff;
    }

    #f9u-classifica-widget table{
      width:100%;
      border-collapse:collapse;
      min-width:920px;
      background:#fff;
    }

    #f9u-classifica-widget th,
    #f9u-classifica-widget td{
      padding:12px 10px;
      border-bottom:1px solid #edf0f4;
      text-align:left;
      font-size:13px;
      vertical-align:middle;
      white-space:nowrap;
    }

    #f9u-classifica-widget th{
      background:#f4f6f9;
      color:#687384;
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.08em;
    }

    #f9u-classifica-widget tbody tr{
      transition:background .15s ease;
    }

    #f9u-classifica-widget tbody tr:hover{
      background:#f8faff;
    }

    #f9u-classifica-widget tbody tr:last-child td{
      border-bottom:none;
    }

    #f9u-classifica-widget td:first-child{
      width:54px;
      font-weight:900;
      font-size:16px;
      color:#354052;
    }

    #f9u-classifica-widget td.f9u-right,
    #f9u-classifica-widget th.f9u-right{
      text-align:right;
    }

    #f9u-classifica-widget td:nth-last-child(1){
      font-size:16px;
      color:#111827;
      background:#fbfcfe;
    }

    #f9u-classifica-widget td:nth-last-child(2){
      color:#20834a;
      font-weight:700;
    }

    #f9u-classifica-widget td:nth-last-child(3){
      color:#667085;
      font-weight:700;
    }

    #f9u-classifica-widget .pilot-name{
      font-weight:800;
      font-size:14px;
      line-height:1.2;
      color:#172033;
    }

    #f9u-classifica-widget .pilot-team{
      font-size:11px;
      color:var(--f9u-muted);
      line-height:1.2;
      margin-top:3px;
    }

    #f9u-classifica-widget .f9u-loader,
    #f9u-classifica-widget .f9u-error,
    #f9u-classifica-widget .f9u-empty,
    #f9u-classifica-widget .f9u-note{
      padding:12px 14px;
      border-radius:9px;
      margin-bottom:14px;
      font-size:13px;
    }

    #f9u-classifica-widget .f9u-loader{
      background:#f5f7fa;
      color:#657082;
      border:1px solid var(--f9u-border);
    }

    #f9u-classifica-widget .f9u-error{
      background:#fff2f2;
      color:#a12626;
      border-left:4px solid #d14343;
      display:none;
    }

    #f9u-classifica-widget .f9u-empty{
      margin:14px;
      background:#f8f9fb;
      color:#737d8b;
      border:1px solid var(--f9u-border);
      display:none;
    }

    #f9u-classifica-widget .f9u-note{
      background:#f7f8fa;
      color:#586273;
      border:1px solid var(--f9u-border);
      font-size:12px;
      line-height:1.5;
    }

    @media (max-width:760px){
      #f9u-classifica-widget .f9u-toolbar{
        justify-content:stretch;
      }

      #f9u-classifica-widget .f9u-field{
        width:100%;
      }

      #f9u-classifica-widget .f9u-section{
        border-radius:11px;
      }

      #f9u-classifica-widget .f9u-title{
        font-size:18px;
        padding:15px 15px 13px 20px;
      }

      #f9u-classifica-widget th,
      #f9u-classifica-widget td{
        padding:10px 8px;
      }
    }

/* gara1 */
#f9u-gara1{
      --f9u-bg:#ffffff;
      --f9u-surface:#ffffff;
      --f9u-surface-soft:#f6f8fb;
      --f9u-border:#e2e7ee;
      --f9u-text:#172033;
      --f9u-muted:#747e8d;
      --f9u-pro:#245fc7;
      --f9u-open:#c62828;

      font-family:Inter, Arial, Helvetica, sans-serif;
      max-width:1100px;
      margin:0 auto;
      color:var(--f9u-text);
    }

    #f9u-gara1 .f9u-lap-records-wrapper *{
      box-sizing:border-box;
    }

    #f9u-gara1 .f9u-collapsible{
      border:1px solid var(--f9u-border);
      border-radius:14px;
      overflow:hidden;
      background:var(--f9u-surface);
      box-shadow:0 8px 24px rgba(32,48,72,.07);
    }

    #f9u-gara1 .f9u-collapsible summary{
      list-style:none;
      cursor:pointer;
      padding:17px 18px 15px 22px;
      background:#fafbfd;
      color:var(--f9u-pro);
      font-size:20px;
      font-weight:800;
      line-height:1.2;
      letter-spacing:.02em;
      text-transform:uppercase;
      display:flex;
      align-items:center;
      justify-content:space-between;
      user-select:none;
      border-bottom:1px solid transparent;
      position:relative;
      transition:background .18s ease,border-color .18s ease;
    }

    #f9u-gara1 .f9u-collapsible summary::before{
      content:"";
      position:absolute;
      left:0;
      top:0;
      bottom:0;
      width:5px;
      background:var(--f9u-pro);
    }

    #f9u-gara1 .f9u-collapsible[open] summary{
      border-bottom-color:var(--f9u-border);
      background:#f8fafc;
    }

    #f9u-gara1 .f9u-collapsible summary:hover{
      background:#f5f8fc;
    }

    #f9u-gara1 .f9u-collapsible summary::-webkit-details-marker{
      display:none;
    }

    #f9u-gara1 .f9u-collapsible summary::after{
      content:"›";
      font-size:26px;
      line-height:1;
      color:#7e8a9b;
      transform:rotate(0deg);
      transition:transform .22s ease,color .18s ease;
      margin-left:12px;
    }

    #f9u-gara1 .f9u-collapsible[open] summary::after{
      transform:rotate(90deg);
      color:var(--f9u-pro);
    }

    #f9u-gara1 .f9u-content{
      padding:0;
      background:#fff;
      overflow-x:auto;
    }

    #f9u-gara1 .f9u-table{
      width:100%;
      min-width:680px;
      border-collapse:collapse;
      background:#fff;
    }

    #f9u-gara1 .f9u-table th{
      text-align:left;
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.08em;
      color:#687384;
      padding:12px 10px;
      border-bottom:1px solid #edf0f4;
      background:#f4f6f9;
      white-space:nowrap;
    }

    #f9u-gara1 .f9u-table td{
      padding:12px 10px;
      border-bottom:1px solid #edf0f4;
      font-size:13px;
      color:#344054;
      vertical-align:middle;
      background:#fff;
    }

    #f9u-gara1 .f9u-table tbody tr{
      transition:background .15s ease;
    }

    #f9u-gara1 .f9u-table tbody tr:hover td{
      background:#f8faff;
    }

    #f9u-gara1 .f9u-table tbody tr:last-child td{
      border-bottom:none;
    }

    #f9u-gara1 .col-pos{
      width:60px;
      text-align:center !important;
      font-weight:900;
      font-size:16px !important;
      color:#354052 !important;
    }

    #f9u-gara1 .pilot-name{
      font-weight:800;
      font-size:14px;
      line-height:1.2;
      color:var(--f9u-text);
    }

    #f9u-gara1 .pilot-call{
      font-size:11px;
      color:var(--f9u-muted);
      margin-top:3px;
      line-height:1.2;
    }

    #f9u-gara1 .badge{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:58px;
      padding:5px 10px;
      border-radius:999px;
      font-size:11px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.04em;
      border:1px solid transparent;
      white-space:nowrap;
    }

    #f9u-gara1 .badge-pro{
      background:#edf3ff;
      color:var(--f9u-pro);
      border-color:#d7e4fb;
    }

    #f9u-gara1 .badge-open{
      background:#fff0f0;
      color:var(--f9u-open);
      border-color:#f4d6d6;
    }

    #f9u-gara1 .col-cat{
      width:90px;
      text-align:right !important;
    }

    #f9u-gara1 .col-time{
      white-space:nowrap;
      font-weight:800;
      text-align:right;
      color:#111827 !important;
      font-variant-numeric:tabular-nums;
    }

    @media (max-width:760px){
      #f9u-gara1 .f9u-collapsible{
        border-radius:11px;
      }

      #f9u-gara1 .f9u-collapsible summary{
        padding:15px 15px 13px 20px;
        font-size:17px;
      }

      #f9u-gara1 .f9u-table th,
      #f9u-gara1 .f9u-table td{
        padding:10px 8px;
      }

      #f9u-gara1 .pilot-name{
        font-size:13px;
      }

      #f9u-gara1 .pilot-call{
        font-size:10px;
      }
    }

